\subsubsection usage Usage
\verbatim
<node name="timoo_cloud_node" pkg="timoo_pointcloud" type="timoo_cloud_node">
  <param name="fixed_frame" type="str" value="timoo" />
  <param name="target_frame" type="str" value="timoo" />
  <param name="min_range" type="double" value="0.9" />
  <param name="max_range" type="double" value="130.0" />
  <param name="view_direction" type="double" value="0.0" />
  <param name="view_width" type="double" value="6.283185307179586" />
  <param name="organize_cloud" type="bool" value="False" />
</node>
\endverbatim

